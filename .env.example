APP_NAME="Benchmark Neuromorphic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

SESSION_DRIVER=file
SESSION_LIFETIME=120
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=benchmark
DB_USERNAME=benchmark
DB_PASSWORD=secret

BENCHMARK_PYTHON=/usr/bin/python3
BENCHMARK_SCRIPT=/var/www/html/python/cli/run_benchmark.py
BENCHMARK_TIMEOUT=3600
